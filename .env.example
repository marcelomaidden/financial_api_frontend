# URL base da API usada pela SPA. Padrão: /api (proxy do Vite em dev).
VITE_API_BASE_URL=/api

# Chave de API enviada no cabeçalho X-API-Key em toda chamada. Lida no build:
# mudar o valor exige um novo build/deploy. Vazia ou ausente: o cabeçalho não é enviado.
# Não coloque a chave real em arquivos versionados.
VITE_API_KEY=
