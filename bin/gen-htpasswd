#!/usr/bin/env ruby
# frozen_string_literal: true

# Gera o arquivo de senhas do auth_basic do nginx a partir de BASIC_AUTH_USER e
# BASIC_AUTH_PASSWORD. Roda a cada início do dyno, antes do nginx (veja o Procfile).
# Falha fechada: qualquer problema termina com status 1 e o dyno não sobe.
# Nenhuma mensagem exibe o usuário ou a senha.

require 'open3'

# Destino do arquivo. O padrão é o caminho usado em config/nginx.conf.erb.
# HTPASSWD_PATH existe para os testes gravarem em um diretório temporário.
HTPASSWD_PATH = ENV.fetch('HTPASSWD_PATH', '/app/.htpasswd')

def fail!(message)
  warn "gen-htpasswd: #{message}"
  exit 1
end

def blank?(value)
  value.nil? || value.strip.empty?
end

user = ENV['BASIC_AUTH_USER']
password = ENV['BASIC_AUTH_PASSWORD']

fail!('BASIC_AUTH_USER ausente ou em branco') if blank?(user)
fail!('BASIC_AUTH_PASSWORD ausente ou em branco') if blank?(password)
fail!('BASIC_AUTH_USER não pode conter ":"') if user.include?(':')
fail!('BASIC_AUTH_USER não pode conter quebra de linha') if user.match?(/[\r\n]/)
# A senha chega ao openssl por uma linha da entrada padrão: uma quebra de linha a truncaria.
fail!('BASIC_AUTH_PASSWORD não pode conter quebra de linha') if password.match?(/[\r\n]/)

# Sem shell: a senha vai pela entrada padrão, nunca pela linha de comando nem pelo log.
hash, _stderr, status = Open3.capture3('openssl', 'passwd', '-apr1', '-stdin', stdin_data: "#{password}\n")
fail!('não foi possível gerar o hash da senha com o openssl') unless status.success?

hash = hash.strip
fail!('o openssl devolveu um hash em formato inesperado') unless hash.start_with?('$apr1$')

File.open(HTPASSWD_PATH, File::WRONLY | File::CREAT | File::TRUNC, 0o600) do |file|
  file.write("#{user}:#{hash}\n")
end
File.chmod(0o600, HTPASSWD_PATH)

puts "gen-htpasswd: arquivo de senhas gerado em #{HTPASSWD_PATH}"
